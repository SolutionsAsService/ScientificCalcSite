  "guide": [
    {
      "expr": "1+2*3",
      "why": "× comes before +."
    },
    {
      "expr": "7-3-2",
      "why": "− and ÷ go left to right."
    },
    {
      "expr": "2^3^2",
      "why": "Powers go right to left."
    },
    {
      "expr": "-2^2",
      "why": "A leading minus waits for the power."
    },
    {
      "expr": "(-2)^2",
      "why": "Brackets put the minus inside."
    },
    {
      "expr": "6/2(1+2)",
      "why": "A number next to a bracket is an ordinary ×, so it goes left to right with ÷."
    },
    {
      "expr": "2pi",
      "why": "A number next to a constant multiplies."
    },
    {
      "expr": "√16+1",
      "why": "√ takes the number right after it."
    },
    {
      "expr": "3!^2",
      "why": "! comes before ^."
    },
    {
      "expr": "sin(30)",
      "why": "Degrees: the reading shows the ° it assumed."
    },
    {
      "expr": "sin(30)",
      "mode": "rad",
      "why": "Radians: the same keys, a different answer."
    },
    {
      "expr": "0.1+0.2",
      "why": "Shown as 0.3; the exact double is 0.30000000000000004."
    }
  ]
}
