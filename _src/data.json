{
  "functions": [
    {
      "group": "Arithmetic",
      "items": [
        {
          "name": "+  −  ×  ÷",
          "what": "Add, subtract, multiply, divide. × and ÷ come before + and −.",
          "examples": [
            "1+2*3",
            "10/4"
          ]
        },
        {
          "name": "x^y",
          "what": "Power. Right to left, so 2^3^2 is 2^(3^2). It comes before a leading minus.",
          "examples": [
            "2^10",
            "2^3^2",
            "-2^2"
          ]
        },
        {
          "name": "n!",
          "what": "Factorial of a whole number from 0 to 170.",
          "examples": [
            "5!",
            "0!"
          ]
        },
        {
          "name": "x%",
          "what": "Percent: divides by 100.",
          "examples": [
            "200*15%"
          ]
        },
        {
          "name": "( )",
          "what": "Brackets. A number next to a bracket, a constant or a root multiplies.",
          "examples": [
            "2(3+4)",
            "2pi"
          ]
        }
      ]
    },
    {
      "group": "Roots, powers and logs",
      "items": [
        {
          "name": "√x  sqrt(x)",
          "what": "Square root.",
          "examples": [
            "√16",
            "sqrt(2)"
          ]
        },
        {
          "name": "∛x  cbrt(x)",
          "what": "Cube root; works for negative numbers.",
          "examples": [
            "∛27",
            "cbrt(-8)"
          ]
        },
        {
          "name": "root(x, n)",
          "what": "The n-th root.",
          "examples": [
            "root(81,4)",
            "root(-32,5)"
          ]
        },
        {
          "name": "exp(x)",
          "what": "e to the power x.",
          "examples": [
            "exp(1)"
          ]
        },
        {
          "name": "ln(x)",
          "what": "Natural log, base e.",
          "examples": [
            "ln(e)",
            "ln(10)"
          ]
        },
        {
          "name": "log(x)  log(x, b)",
          "what": "Log base 10, or base b.",
          "examples": [
            "log(1000)",
            "log(8,2)"
          ]
        },
        {
          "name": "log2(x)",
          "what": "Log base 2.",
          "examples": [
            "log2(1024)"
          ]
        }
      ]
    },
    {
      "group": "Trigonometry",
      "items": [
        {
          "name": "sin  cos  tan",
          "what": "In degrees unless you switch to RAD.",
          "examples": [
            "sin(30)",
            "cos(60)",
            "tan(45)"
          ]
        },
        {
          "name": "sin  cos  tan (RAD)",
          "mode": "rad",
          "what": "In radians: the same keys after switching to RAD.",
          "examples": [
            "sin(pi/6)",
            "cos(pi)"
          ]
        },
        {
          "name": "asin  acos  atan",
          "what": "Inverse trig; answers in the current angle unit.",
          "examples": [
            "asin(0.5)",
            "atan(1)"
          ]
        },
        {
          "name": "sinh  cosh  tanh  asinh  acosh  atanh",
          "what": "Hyperbolic functions and their inverses (no angle unit).",
          "examples": [
            "sinh(1)",
            "tanh(0.5)",
            "asinh(1)"
          ]
        }
      ]
    },
    {
      "group": "Counting and rounding",
      "items": [
        {
          "name": "nCr(n, r)",
          "what": "Combinations: ways to choose r from n. Above 2⁵³ (about 9 × 10¹⁵) results are floating-point approximations.",
          "examples": [
            "nCr(52,5)"
          ]
        },
        {
          "name": "nPr(n, r)",
          "what": "Permutations: ordered choices of r from n.",
          "examples": [
            "nPr(5,2)"
          ]
        },
        {
          "name": "mod(a, b)",
          "what": "Remainder, always 0 or positive for positive b.",
          "examples": [
            "mod(-7,3)"
          ]
        },
        {
          "name": "abs  sign  floor  ceil  round",
          "what": "Absolute value, sign, and rounding. round sends halves away from zero.",
          "examples": [
            "abs(-3.5)",
            "floor(2.7)",
            "round(2.5)",
            "round(-2.5)"
          ]
        },
        {
          "name": "min  max  hypot",
          "what": "Smallest, largest, and √(a² + b² + …).",
          "examples": [
            "max(1,9,4)",
            "hypot(3,4)"
          ]
        }
      ]
    }
  ],
